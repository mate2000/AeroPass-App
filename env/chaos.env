# Fault injection (015 observability, specs/015-observabilidad-sentry/contracts/telemetry-events.md §6).
# A chaos build shows the fault panel (the ⚡ button) and tags Sentry as the `chaos` environment,
# so the dashboards can be filtered to the experiment. Never use these flags in a release build:
# the app refuses to start, and tool/check_release_env.dart rejects them.
#
# Point API_BASE_URL at the backend's Vercel Preview (its own Neon branch, Upstash and Blob), not at
# production, when injecting backend faults. Client-side faults only affect this phone.
API_BASE_URL=https://aeropass-lac.vercel.app
# If the Preview has Deployment Protection on: its "Protection Bypass for Automation" secret.
VERCEL_PROTECTION_BYPASS=
# The Preview's FAULT_INJECTION_SECRET (backend spec 003), if it has one: sent as X-AeroPass-Fault-Key.
FAULT_INJECTION_KEY=
SENTRY_DSN=https://8eab04c9f4d0568602e177f176a5c8c0@o4512131329359872.ingest.us.sentry.io/4512133554438144
SENTRY_ENVIRONMENT=chaos
SENTRY_SEND_TEST_EVENT=false
# A1 fires in every environment, including chaos.
SENTRY_ALERT_RULE_CONFIRMED=true
# Low volume: keep every trace, profile and replay of the experiment.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_REPLAY_SESSION_SAMPLE_RATE=1.0
SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=pk_test_ZGlzY3JldGUtc2F0eXItNzI5OC5jbGVyay5hY2NvdW50cy5kZXYk
CHAOS_TOOLS=true
# true: MOCK: marker selfies and the marker picker (for the backend's mock provider).
# false: the real camera (for MxFace).
SYNTHETIC_CAPTURE=true
BIOMETRIC_PROVIDER_MOCK=true
