# 015 presentation runs: same dev-only fakes as dev-offline.env, tagged as the
# `demo` environment so the Sentry dashboard can filter it apart from real
# traffic. Never use these flags in a release build (the app refuses to start).
API_BASE_URL=https://api.dev.aeropass.example
SENTRY_DSN=https://8eab04c9f4d0568602e177f176a5c8c0@o4512131329359872.ingest.us.sentry.io/4512133554438144
SENTRY_ENVIRONMENT=demo
SENTRY_SEND_TEST_EVENT=false
USE_FAKE_CONSENT_BACKEND=true
USE_FAKE_VERIFICATION_BACKEND=true
# 011: true since 015 created the alert "A1" on failure_class:service (all environments).
SENTRY_ALERT_RULE_CONFIRMED=true
# 015 research §7: low volume, so every trace, profile and replay is kept.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_REPLAY_SESSION_SAMPLE_RATE=1.0
SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
