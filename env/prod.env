# Build-time values for prod builds, read with --dart-define-from-file.
API_BASE_URL=https://api.aeropass.example
SENTRY_DSN=https://8eab04c9f4d0568602e177f176a5c8c0@o4512131329359872.ingest.us.sentry.io/4512133554438144
SENTRY_ENVIRONMENT=prod
SENTRY_SEND_TEST_EVENT=false
# 011: true since 015 created the alert "A1" on failure_class:service (all environments).
SENTRY_ALERT_RULE_CONFIRMED=true
# 015 research §7: sampled to keep the Sentry cost per validation low (KR A4.3).
# Errors, crashes and funnel events are always sent in full.
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2
SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
